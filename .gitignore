# Godot caches and generated import metadata
.godot/
*.import
*.uid

# Only the production tile atlas and its required Godot TileSet definition are public.
# All other tile work files stay local.
/tile/*
!/tile/tiles_256_big.png
!/tile/tiles_256_big.tres

# Unused source assets; the game uses ico.png and OGV intro videos
/img/ico1.png
/video/mp4/

# Local helper tools are not part of the public project
/tools/

# Local AI assistant instructions and configuration
/CLAUDE.md
/.claude/

# Android Gradle project and local build output (regenerated by Godot)
/android/

# Signing credentials -- never publish these files or their passwords
*.jks
*.keystore
*.keystore.properties
keystore.properties
/keystore.private.md

# Exported release binaries are attached to a GitHub Release, not committed
/export/
*.pck
*.apk
*.aab
*.exe
*.x86_64
*.arm64

# Editor and operating-system temporary files
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
